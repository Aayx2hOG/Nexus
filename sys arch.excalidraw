    {
      "id": "64a851dc339f48038e21",
      "type": "text",
      "x": -850,
      "y": 2170,
      "width": 475.8,
      "height": 150.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
